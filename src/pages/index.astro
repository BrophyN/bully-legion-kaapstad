---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bully Legion KaapStad | Same Blood. Higher Standards." description="A Cape Town American Bully programme focused on welfare, sound structure, and transparent records.">
	  <section class="hero">
			<img src="/brand/blk-banner.jpg" alt="Bully Legion KaapStad American Bully programme beneath Table Mountain" />
		</section>

		<section class="hero-actions-band">
			<div class="container"><p>Responsible American Bully breeding in Cape Town.</p><div><a class="button primary" href="/care">Care & tools</a><a class="button dark" href="/about">Our approach</a></div></div>
		</section>

	<section class="intro container">
		<div><p class="eyebrow">The BLK standard</p><h2 class="display">Cape Town roots.<br />A legacy in the making.</h2></div>
		<p>BLK exists to develop healthy, stable American Bullies through thoughtful selection and responsible ownership. We share the work behind the dogs: records, education, care, and the long view.</p>
	</section>

	<section class="paths">
		<div class="container path-grid">
			<a href="/studs"><span>01</span><strong>Studs</strong><small>Profiles and records</small></a>
			<a href="/females"><span>02</span><strong>Females</strong><small>Profiles and records</small></a>
			<a href="/care"><span>03</span><strong>Care & tools</strong><small>Practical owner guidance</small></a>
		</div>
	</section>
</Layout>

<style>
	.hero { background: var(--obsidian); }
	.hero img { width: 100%; aspect-ratio: 708 / 312; object-fit: cover; object-position: center; }
	.hero-actions-band { background: var(--ivory); border-bottom: 1px solid #c5bcae; }
	.hero-actions-band > div { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 92px; }
	.hero-actions-band p { margin: 0; color: var(--muted); font-family: var(--accent); font-size: 1.1rem; font-style: italic; }
	.hero-actions-band div div { display: flex; gap: 0.75rem; flex-wrap: wrap; }
	.button.dark { border-color: var(--obsidian); color: var(--obsidian); }
	.intro { display: grid; grid-template-columns: 1fr minmax(0, 0.65fr); gap: 4rem; padding: 7rem 0; }
	.intro h2 { margin: 0; font-size: clamp(3rem, 6vw, 5.5rem); }
	.intro > p { align-self: end; margin: 0; color: var(--muted); font-size: 1.1rem; }
	.paths { background: var(--charcoal); color: var(--ivory); }
	.path-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
	.path-grid a { display: grid; gap: 0.45rem; min-height: 205px; padding: 2rem; border-right: 1px solid var(--line); transition: background 180ms ease; }
	.path-grid a:hover { background: var(--bronze); color: var(--obsidian); }
	.path-grid span { color: var(--bronze); font-size: 0.9rem; font-weight: 700; }
	.path-grid a:hover span { color: var(--obsidian); }
	.path-grid strong { font-family: var(--display); font-size: 2.5rem; line-height: 1; }
	.path-grid small { color: rgba(232,225,213,0.7); }
	.path-grid a:hover small { color: rgba(23,24,23,0.75); }
	@media (max-width: 700px) { .hero img { aspect-ratio: 1.1 / 1; object-position: center; } .hero-actions-band > div { align-items: flex-start; flex-direction: column; padding: 1.25rem 0; } .intro { grid-template-columns: 1fr; gap: 1.5rem; padding: 4rem 0; } .path-grid { grid-template-columns: 1fr; } .path-grid a { min-height: 150px; border-bottom: 1px solid var(--line); } }
</style>
