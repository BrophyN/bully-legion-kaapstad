---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Layout title="Care & Tools | Bully Legion KaapStad" description="Practical education and responsible planning tools from BLK.">
  <PageIntro eyebrow="Owner education" title="Care & tools." copy="Practical starting points for informed owners. These tools are educational and do not replace individual veterinary advice, registered pedigree records, or health testing." />
  <section class="tools container">
    <article class="tool"><div><p class="eyebrow">Daily feeding guide</p><h2 class="display">Food calculator</h2><p>Estimate a daily food range from adult dog weight and activity. Adjust with body condition and your veterinarian's guidance.</p></div><form id="food-form"><label>Weight (kg)<input id="weight" type="number" min="1" value="30" required /></label><label>Activity<select id="activity"><option value="1.6">Low</option><option value="1.8" selected>Typical adult</option><option value="2.2">High</option></select></label><button class="button primary" type="submit">Calculate</button><output id="food-result" aria-live="polite"></output></form></article>
    <article class="tool coi"><div><p class="eyebrow">Pedigree planning</p><h2 class="display">COI calculator</h2><p>Enter each documented common-ancestor path. The calculator applies Wright's path coefficient: F = sum of (1/2)^(n1 + n2 + 1) x (1 + FA).</p></div><form id="coi-form"><div id="coi-rows"><div class="coi-row"><label>Common ancestor<input name="ancestor" value="Ancestor A" required /></label><label>Sire generations<input name="sire-generation" type="number" min="0" value="2" required /></label><label>Dam generations<input name="dam-generation" type="number" min="0" value="2" required /></label><label>Ancestor COI %<input name="ancestor-coi" type="number" min="0" max="100" value="0" required /></label></div></div><div class="form-actions"><button class="button add" type="button" id="add-path">Add path</button><button class="button primary" type="submit">Calculate COI</button></div><output id="coi-result" aria-live="polite"></output></form></article>
  </section>
</Layout>
<script>
  const foodForm = document.querySelector<HTMLFormElement>('#food-form');
  const foodResult = document.querySelector<HTMLOutputElement>('#food-result');
  foodForm?.addEventListener('submit', (event) => { event.preventDefault(); const weight = Number((document.querySelector('#weight') as HTMLInputElement).value); const activity = Number((document.querySelector('#activity') as HTMLSelectElement).value); const calories = 70 * Math.pow(weight, 0.75) * activity; const grams = Math.round(calories / 3.8); if (foodResult) foodResult.value = `Starting estimate: ${Math.round(calories)} kcal/day, or about ${grams} g/day of a 3.8 kcal/g food.`; });
  const coiForm = document.querySelector<HTMLFormElement>('#coi-form');
  const coiRows = document.querySelector('#coi-rows');
  const coiResult = document.querySelector<HTMLOutputElement>('#coi-result');
  document.querySelector('#add-path')?.addEventListener('click', () => { const row = document.querySelector('.coi-row')?.cloneNode(true) as HTMLElement; row.querySelectorAll('input').forEach((input) => { input.value = input.name === 'ancestor' ? '' : '0'; }); coiRows?.append(row); });
  coiForm?.addEventListener('submit', (event) => { event.preventDefault(); let coefficient = 0; document.querySelectorAll('.coi-row').forEach((row) => { const inputs = row.querySelectorAll('input'); const sire = Number((inputs[1] as HTMLInputElement).value); const dam = Number((inputs[2] as HTMLInputElement).value); const ancestor = Number((inputs[3] as HTMLInputElement).value) / 100; coefficient += Math.pow(0.5, sire + dam + 1) * (1 + ancestor); }); if (coiResult) coiResult.value = `Estimated pedigree-path COI: ${(coefficient * 100).toFixed(2)}%. Confirm every path and shared ancestor against official pedigree records.`; });
</script>
<style>
  .tools { padding: 5rem 0 7rem; } .tool { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 4rem; padding: 3rem 0; border-top: 1px solid #c5bcae; } .tool:last-child { border-bottom: 1px solid #c5bcae; } h2 { margin: 0; font-size: clamp(3rem, 5vw, 5rem); } .tool div > p:last-child { color: var(--muted); } form { display: grid; gap: 1rem; align-content: start; } label { display: grid; gap: 0.4rem; color: var(--muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; } input, select { width: 100%; min-height: 48px; border: 1px solid #bcb3a6; border-radius: 0; padding: 0.7rem; background: #f3ede4; color: var(--ink); } output { display: block; min-height: 1.5rem; color: var(--charcoal); font-weight: 700; } .coi-row { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 0.75rem; } .form-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; } .add { border-color: var(--charcoal); background: transparent; color: var(--charcoal); } @media (max-width: 780px) { .tools { padding: 3.5rem 0 5rem; } .tool { grid-template-columns: 1fr; gap: 1.5rem; } .coi-row { grid-template-columns: 1fr 1fr; } }
</style>